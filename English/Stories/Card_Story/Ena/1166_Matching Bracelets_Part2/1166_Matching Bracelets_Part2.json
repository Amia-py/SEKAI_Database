  },
  {
   "Speaker": "Mizuki",
   "Line": "<I'm here. Are you done drawing that variation?>",
   "_kind": "talk"
  },
  {
   "Speaker": "Ena",
   "Line": "<Yeah, I'll send it over now. Let me know if it's what you had in mind.>",
   "_kind": "talk"
  },
  {
   "Speaker": "Mizuki",
   "Line": "<Okie dokie!>",
   "_kind": "talk"
  },
  {
   "Speaker": "",
