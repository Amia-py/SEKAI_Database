  },
  {
   "Speaker": "",
   "Line": "bg_h000309",
   "_kind": "Background Change"
  },
  {
   "Speaker": "",
   "Line": "bg_e000303",
   "_kind": "Background Change"
  },
  {
   "Speaker": "Ena",
   "Line": "<I mean, where you are isn't gonna change who we are.>",
