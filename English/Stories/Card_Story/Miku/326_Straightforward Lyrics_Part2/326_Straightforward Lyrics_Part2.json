   "_kind": "talk"
  },
  {
   "Speaker": "Miku",
   "Line": "<I can't actually touch it...>",
   "_kind": "talk"
  },
  {
   "Speaker": "Mafuyu",
   "Line": "Oh... You are a hologram right now...\nI'll try for you instead...",
   "_kind": "talk"
  },
  {
   "Speaker": "Mafuyu",
   "Line": "Here, this is snow...",
   "_kind": "talk"
  },
  {
