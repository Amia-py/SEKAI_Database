  },
  {
   "話者": "瑞希",
   "セリフ": "『雪がいなくなっちゃった日にさ、\nボク、雪と雪のお母さんが話してるの聞いちゃったんだよね』",
   "_kind": "talk"
  },
  {
   "話者": "瑞希",
   "セリフ": "『雪のお母さん、ナチュラルに価値観押しつける感じの人でさ。\nでも、雪は全然気にしてないって感じで受け止めてたんだ』",
   "_kind": "talk"
  },
  {
   "話者": "瑞希",
   "セリフ": "『雪がいいならそれでいいのかなって思ったんだけど、\n……でも、セカイであんな感じになっちゃってたでしょ？』",
   "_kind": "talk"
  },
  {
   "話者": "瑞希",
   "セリフ": "『だから、雪はお母さんのために、無理に“いい子”に\nなろうとしちゃってたんじゃないのかなーって思って』",
   "_kind": "talk"
  },
  {
   "話者": "絵名",
   "セリフ": "『…………』",
   "_kind": "talk"
  },
  {
   "話者": "瑞希",
   "セリフ": "『……ううん、お母さんのためだけじゃないかも』",
   "_kind": "talk"
  },
  {
   "話者": "瑞希",
   "セリフ": "『雪は、周りに合わせて自分を変えてっちゃったのかもしれない』",
   "_kind": "talk"
  },
  {
   "話者": "瑞希",
   "セリフ": "『みんなに慕われて、誰にも迷惑かけない、\nみんなにとっての“いい子”にならなきゃって思って……』",
   "_kind": "talk"
  },
  {
   "話者": "瑞希",
   "セリフ": "『そういうのがキツくって、\n全部わからなくなっちゃったんじゃないかなって。\nなんとなく、そんな気がするんだ』",
   "_kind": "talk"
  },
  {
   "話者": "絵名",
   "セリフ": "『………………』",
   "_kind": "talk"
  },
  {
   "話者": "瑞希",
   "セリフ": "『……別にボクは、雪みたいないい子ってわけじゃないけど』",
   "_kind": "talk"
  },
  {
   "話者": "瑞希",
   "セリフ": "『なんとなくわかるんだよね。\nみんなに合わせなきゃいけないって空気が\nすごく苦痛だってことは、ボクも知ってるから』",
   "_kind": "talk"
  },
  {
   "話者": "絵名",
   "セリフ": "『……Amiaでも、そういう風に思うことあるんだ』",
   "_kind": "talk"
  },
  {
   "話者": "瑞希",
   "セリフ": "『まぁねー』",
   "_kind": "talk"
  },
  {
   "話者": "瑞希",
   "セリフ": "『って、ちょっとちょっとー！　ボクでもってどういう意味！？\nボクだってキツい時はあるんですけど～！？』",
   "_kind": "talk"
  },
  {
   "話者": "絵名",
   "セリフ": "『あ……ごめん。\nでもAmiaって、わりといつも自由だし、\n楽しそうにしてるから』",
   "_kind": "talk"
  },
  {
   "話者": "瑞希",
   "セリフ": "『え？　ま、そりゃねー！\n人生楽しまなきゃ損だし？』",
   "_kind": "talk"
  },
  {
   "話者": "瑞希",
   "セリフ": "『いつまでもネガってちゃ楽しくないもん！\nえななんだって、毎日パーっとやりたいでしょっ♪』",
   "_kind": "talk"
  },
  {
   "話者": "絵名",
   "セリフ": "『まあ……楽しくは、生きたいけど』",
   "_kind": "talk"
  },
  {
   "話者": "瑞希",
   "セリフ": "『……でも、雪は、そういう風にできなかったんだろうね』",
   "_kind": "talk"
  },
  {
   "話者": "瑞希",
   "セリフ": "『ひとりで抱えて、限界がきちゃったんだろうなぁ……』",
   "_kind": "talk"
  },
  {
   "話者": "絵名",
   "セリフ": "『…………』",
   "_kind": "talk"
  },
  {
   "話者": "瑞希",
   "セリフ": "『だから、思うんだよね。\nもし雪も苦しんでて、そのせいでああなっちゃって、\nそれで、消えちゃうっていうのは……』",
   "_kind": "talk"
  },
  {
   "話者": "瑞希",
   "セリフ": "『ボクは、ちょっと寂しいなって』",
   "_kind": "talk"
  },
  {
   "話者": "絵名",
   "セリフ": "『…………』",
   "_kind": "talk"
  },
  {
   "話者": "瑞希",
   "セリフ": "『……ボク、もう１回、雪と話したいな』",
   "_kind": "talk"
  },
  {
   "話者": "瑞希",
   "セリフ": "『あの“Untitled”って曲を再生すれば行けるんだよね。\nそれなら……』",
