   "_kind": "talk"
  },
  {
   "話者": "",
   "セリフ": "bgm00015",
   "_kind": "効果音・BGM"
  },
  {
   "話者": "類",
   "セリフ": "だろう？　そして丁度ここに、プラズマを発生させる装置が――",
