  {
   "話者": "寧々",
   "セリフ": "（うわっ、やっぱり速い……！\n落としかたも正確だし、迷いがない）",
   "_kind": "talk"
  },
  {
   "話者": "えむ",
   "セリフ": "すごいね！\nさっきよりも、びゅびゅびゅびゅーんって積んでいってる！",
   "_kind": "talk"
  },
  {
   "話者": "彰人",
   "セリフ": "（……調子いいみてえだな。\nこのままいけば冬弥が勝つのは確実だが、問題は——）",
   "_kind": "talk"
  },
  {
   "話者": "俺達さいつよA",
   "セリフ": "…………",
   "_kind": "talk"
  },
  {
   "話者": "",
   "セリフ": "se00097",
   "_kind": "効果音・BGM"
  },
  {
   "話者": "彰人",
   "セリフ": "（……やっぱり、動き出したか）",
   "_kind": "talk"
  },
  {
   "話者": "彰人",
   "セリフ": "……あの、どうかしましたか？\nまだ試合中ですけど",
   "_kind": "talk"
  },
  {
   "話者": "俺達さいつよA",
   "セリフ": "今後の参考に彼の技を近くで見たくてさ。\nでも俺、目が悪くて……近づかないと見えないんだよ",
   "_kind": "talk"
  },
  {
   "話者": "彰人",
   "セリフ": "（こいつ……）",
   "_kind": "talk"
  },
  {
   "話者": "彰人",
   "セリフ": "すみません、彼の集中を切らしたくないので……。\nよかったら動画撮っておくので、あとで送りますよ",
   "_kind": "talk"
  },
  {
   "話者": "俺達さいつよA",
   "セリフ": "チッ……",
   "_kind": "talk"
  },
  {
   "話者": "寧々",
   "セリフ": "（あれ……東雲くんとあの人、なんか揉めてる？\nやっぱりあのチーム、何か……）",
   "_kind": "talk"
  },
  {
   "話者": "俺達さいつよB",
   "セリフ": "くっ、まずい！\nこのままじゃ負ける……！",
   "_kind": "talk"
  },
  {
   "話者": "俺達さいつよA",
   "セリフ": "——クソッ、こうなったら……",
   "_kind": "talk"
  },
  {
   "話者": "",
   "セリフ": "se00167",
   "_kind": "効果音・BGM"
  },
  {
   "話者": "寧々",
   "セリフ": "あっ……！",
   "_kind": "talk"
  },
  {
   "話者": "冬弥",
   "セリフ": "……！",
   "_kind": "talk"
  },
  {
   "話者": "えむ",
   "セリフ": "あっ、ジュースこぼしちゃった！",
   "_kind": "talk"
  },
  {
   "話者": "寧々",
   "セリフ": "……違う。\n明らかにわざと青柳くんの手にかけてた……",
   "_kind": "talk"
  },
  {
   "話者": "彰人",
   "セリフ": "てめっ……！",
   "_kind": "talk"
  },
  {
