  },
  {
   "話者": "瑞希",
   "セリフ": "（ま、小テストもちゃんと受けたし\nこれでしばらくは大丈夫かな）",
   "_kind": "talk"
  },
  {
   "話者": "瑞希",
   "セリフ": "（放課後は、杏と弟くんにも久しぶりに会えたし……\n今日は顔出した甲斐があったかも）",
   "_kind": "talk"
  },
  {
   "話者": "瑞希",
   "セリフ": "ん〜、晩ごはんまではまだ時間あるし\nちょっと作業しようかな",
   "_kind": "talk"
  },
  {
   "話者": "瑞希",
   "セリフ": "昨日、絵名があげてくれてたラフ確認して——",
   "_kind": "talk"
  },
  {
   "話者": "",
   "セリフ": "se00007_b",
   "_kind": "効果音・BGM"
  },
  {
   "話者": "瑞希",
   "セリフ": "って、あれ？　絵名、ログインしてるじゃん",
   "_kind": "talk"
  },
  {
   "話者": "",
   "セリフ": "se00084_b",
   "_kind": "効果音・BGM"
  },
  {
   "話者": "瑞希",
   "セリフ": "『やっほー。お疲れ、えななん！\n作業してたんだね』",
   "_kind": "talk"
  },
  {
   "話者": "",
   "セリフ": "bg_e000302",
   "_kind": "背景変化"
  },
  {
   "話者": "絵名",
   "セリフ": "『あ……Amia、お疲れ。\n絵画教室の課題終わって、ちょっと時間できたから\nラフのパターン出してたとこ』",
   "_kind": "talk"
  },
  {
   "話者": "絵名",
   "セリフ": "『Amiaは何してたの？』",
   "_kind": "talk"
  },
  {
   "話者": "",
   "セリフ": "bg_h000406",
   "_kind": "背景変化"
  },
  {
   "話者": "瑞希",
   "セリフ": "『ふっふっふ。\nなんと今日は、学校行ってたんだ！　偉いでしょ♪』",
   "_kind": "talk"
  },
  {
   "話者": "絵名",
   "セリフ": "『偉いって……どうせ、いつも通りお昼からでしょ』",
   "_kind": "talk"
  },
  {
   "話者": "瑞希",
   "セリフ": "『あはは、バレてる〜』",
   "_kind": "talk"
  },
  {
   "話者": "",
   "セリフ": "bg_e000402",
   "_kind": "背景変化"
  },
  {
   "話者": "瑞希",
   "セリフ": "『そういえば、学校で弟くん達に会ったんだけどさ、\nアメリカ行ってた分の補習が大変だってぼやいてたよ』",
   "_kind": "talk"
  },
  {
   "話者": "",
   "セリフ": "bg_h000406",
   "_kind": "背景変化"
  },
  {
   "話者": "絵名",
   "セリフ": "『まあ、そういう約束だったんだし、仕方ないでしょ』",
   "_kind": "talk"
  },
  {
   "話者": "絵名",
   "セリフ": "『でも、帰ってきてからまた練習に力入ってるみたいだし……\nいい刺激になったんじゃない？』",
   "_kind": "talk"
  },
  {
   "話者": "瑞希",
   "セリフ": "『へえ……』",
