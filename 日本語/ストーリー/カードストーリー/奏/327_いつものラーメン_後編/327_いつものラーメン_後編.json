  },
  {
   "話者": "",
   "セリフ": "bg_h000108",
   "_kind": "背景変化"
  },
  {
   "話者": "絵名",
   "セリフ": "『なら、やっぱり音楽関係の話で盛り上がったりしたの？』",
   "_kind": "talk"
  },
  {
   "話者": "奏",
   "セリフ": "『うん。わたし達がどんな風に曲や動画を作ってるか、\nすごく興味を持ってくれてた』",
   "_kind": "talk"
  },
  {
   "話者": "",
   "セリフ": "bg_h000208",
   "_kind": "背景変化"
  },
  {
   "話者": "まふゆ",
   "セリフ": "『そうだね。あと、ミクが歌ってる曲の話と\n髪の話もした』",
   "_kind": "talk"
  },
  {
   "話者": "絵名",
   "セリフ": "『髪の話？』",
   "_kind": "talk"
  },
  {
   "話者": "",
   "セリフ": "bg_h000108",
   "_kind": "背景変化"
  },
  {
   "話者": "奏",
   "セリフ": "『ふふ。実は今日集まった４人とも、\nみんな髪が長めだったんだけど——』",
   "_kind": "talk"
  },
  {
   "話者": "奏",
   "セリフ": "『ロングヘアでよくある話で、ちょっと盛り上がったんだ』",
   "_kind": "talk"
  },
  {
   "話者": "",
   "セリフ": "bg_h000109",
   "_kind": "背景変化"
  },
  {
   "話者": "瑞希",
   "セリフ": "『え、何それ！　おもしろそー！\nたとえばどんなあるあるが出たの？』",
   "_kind": "talk"
  },
  {
   "話者": "奏",
   "セリフ": "『えっとまず……髪を椅子の背もたれに挟んだり、\nお尻で踏んじゃったりとか――』",
   "_kind": "talk"
  },
  {
   "話者": "瑞希",
   "セリフ": "『あっ！　髪が引っ張られて頭がくってなるヤツ！』",
   "_kind": "talk"
  },
  {
   "話者": "奏",
   "セリフ": "『そう、それ』",
