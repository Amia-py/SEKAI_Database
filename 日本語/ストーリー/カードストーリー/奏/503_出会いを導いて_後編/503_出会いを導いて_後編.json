  },
  {
   "話者": "",
   "セリフ": "bg_e000303",
   "_kind": "背景変化"
  },
  {
   "話者": "絵名",
   "セリフ": "『……んーっ。\nキリもいいし、私も落ちようかな』",
   "_kind": "talk"
  },
  {
   "話者": "",
   "セリフ": "bg_h000108",
   "_kind": "背景変化"
  },
  {
   "話者": "奏",
   "セリフ": "『あ、待って、えななん』",
   "_kind": "talk"
  },
  {
   "話者": "奏",
   "セリフ": "『今日、望月さんが家に来てくれたんだけど、\n職場体験のこと、すごく感謝してたよ』",
   "_kind": "talk"
  },
  {
   "話者": "奏",
   "セリフ": "『それに、次はデッサンを教えてもらうって\n楽しみにしてるみたいだった』",
   "_kind": "talk"
  },
  {
   "話者": "絵名",
   "セリフ": "『ほんと？　よかったー！』",
   "_kind": "talk"
  },
  {
   "話者": "",
   "セリフ": "bg_e000403",
   "_kind": "背景変化"
  },
  {
   "話者": "瑞希",
   "セリフ": "『あ、それって、絵のことで困ってるっていう\nお手伝いさんに絵を教えるって言ってたやつ？』",
   "_kind": "talk"
  },
  {
   "話者": "",
   "セリフ": "bg_h000409",
   "_kind": "背景変化"
  },
  {
   "話者": "絵名",
   "セリフ": "『そうそう。職場体験で子供達と絵を描くから、\n自分も描けるようになりたいって言っててね』",
   "_kind": "talk"
  },
  {
   "話者": "絵名",
   "セリフ": "『それで、簡単に動物を描くコツみたいのを教えて、\n結構いい感じに“これは猫なんだな”って\nわかりやすい絵を描けるようになったの』",
   "_kind": "talk"
  },
  {
   "話者": "",
   "セリフ": "bg_h000108",
   "_kind": "背景変化"
  },
  {
   "話者": "奏",
   "セリフ": "『え、そうなの？』",
   "_kind": "talk"
  },
  {
   "話者": "",
   "セリフ": "bg_h000109",
   "_kind": "背景変化"
  },
  {
   "話者": "瑞希",
   "セリフ": "『ん？　なんでそこで驚くの……？』",
   "_kind": "talk"
  },
  {
   "話者": "瑞希",
   "セリフ": "『ああ。もしかして、その望月さんっていう子、\nいわゆる画伯的な感じの絵を描く子だったの？』",
   "_kind": "talk"
  },
  {
   "話者": "",
   "セリフ": "bg_h000309",
   "_kind": "背景変化"
  },
  {
   "話者": "絵名",
   "セリフ": "『ま、まあね……』",
   "_kind": "talk"
  },
  {
   "話者": "絵名",
   "セリフ": "『本人も結構それを気にしてて、\n誰にでも何を描いたかわかる絵を描きたいって\nすごく思ってたみたいなんだけど……』",
   "_kind": "talk"
  },
  {
   "話者": "瑞希",
   "セリフ": "『……けど？』",
   "_kind": "talk"
  },
  {
   "話者": "",
   "セリフ": "bg_e000303",
   "_kind": "背景変化"
  },
  {
   "話者": "絵名",
   "セリフ": "『なんていうか、うまくなればなるほど\n穂波ちゃんだから描ける魅力が消えていっちゃって……』",
   "_kind": "talk"
  },
  {
   "話者": "絵名",
   "セリフ": "『望みは叶えてあげられたけど、\n本当にそれでいいのかなって、ちょっと迷ったんだよね』",
   "_kind": "talk"
  },
  {
   "話者": "",
   "セリフ": "bg_h000108",
   "_kind": "背景変化"
  },
  {
   "話者": "奏",
   "セリフ": "『そうだったんだ……』",
   "_kind": "talk"
  },
  {
   "話者": "絵名",
   "セリフ": "『それで結局、“穂波ちゃんの絵”を描いてみてって提案したの』",
   "_kind": "talk"
  },
  {
   "話者": "奏",
   "セリフ": "『その話、望月さんからも聞いたよ。\nそれで吹っ切れたって』",
   "_kind": "talk"
  },
  {
   "話者": "絵名",
   "セリフ": "『うん……』",
   "_kind": "talk"
  },
  {
   "話者": "",
   "セリフ": "bg_e000303",
   "_kind": "背景変化"
  },
  {
   "話者": "絵名",
   "セリフ": "『穂波ちゃんに必要だったのは、きっと技術じゃなくて\n絵を楽しむ気持ちだったんだと思う』",
   "_kind": "talk"
  },
  {
   "話者": "",
   "セリフ": "bg_h000109",
   "_kind": "背景変化"
  },
  {
   "話者": "瑞希",
   "セリフ": "『へえ……』",
   "_kind": "talk"
  },
  {
   "話者": "",
   "セリフ": "bg_h000309",
   "_kind": "背景変化"
  },
  {
   "話者": "瑞希",
   "セリフ": "『えななん、ちゃんと先生としてがんばってたんだね～』",
   "_kind": "talk"
  },
  {
   "話者": "絵名",
   "セリフ": "『あのねえ、絵のことで私がふざけるわけないでしょ』",
