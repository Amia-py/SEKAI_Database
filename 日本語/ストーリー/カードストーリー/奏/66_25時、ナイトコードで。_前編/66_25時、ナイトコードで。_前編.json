  },
  {
   "話者": "奏",
   "セリフ": "『あるいは……運命共同体として、もっと知りたいのかも』",
   "_kind": "talk"
  },
  {
   "話者": "まふゆ",
   "セリフ": "『ふふ。そっちなら、わかるような気がする』",
   "_kind": "talk"
  },
  {
   "話者": "奏",
   "セリフ": "『じゃあ、まふゆ。\nまふゆのことを、いろいろ教えて』",
   "_kind": "talk"
  },
  {
   "話者": "まふゆ",
   "セリフ": "『……私のこと、か……。\nひどいこと聞くんだね』",
   "_kind": "talk"
  },
  {
   "話者": "まふゆ",
   "セリフ": "『自分のことがわからない人間に、\n“あなたのことを教えて”だなんて』",
   "_kind": "talk"
  },
  {
   "話者": "奏",
   "セリフ": "『でも、勉強する時も、\n人に説明すれば理解が深まるっていうでしょ？』",
   "_kind": "talk"
  },
  {
   "話者": "まふゆ",
   "セリフ": "『……ふふ。たしかに勉強の仕方としては\n間違ってないかもしれないけど……』",
   "_kind": "talk"
  },
  {
   "話者": "まふゆ",
   "セリフ": "『私は、今笑ったのだって、\nどういう気持ちで笑ったのかわからないよ』",
   "_kind": "talk"
  },
  {
   "話者": "奏",
   "セリフ": "『……それでも』",
   "_kind": "talk"
  },
  {
   "話者": "奏",
   "セリフ": "『それでも、まふゆのことが知りたい。\nなんでもいいから話してみて。部屋にあるものとか』",
   "_kind": "talk"
  },
  {
   "話者": "まふゆ",
   "セリフ": "『部屋にあるもの……そうだね。\n机のそばには、教科書があって、辞書があって、本があるよ』",
