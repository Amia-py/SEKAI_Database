  },
  {
   "話者": "",
   "セリフ": "bg_h000309",
   "_kind": "背景変化"
  },
  {
   "話者": "瑞希",
   "セリフ": "『ボクもご飯食べるために\nちょっと抜けて戻ってきたところだよ』",
   "_kind": "talk"
  },
  {
   "話者": "",
   "セリフ": "bg_e000403",
   "_kind": "背景変化"
  },
  {
   "話者": "瑞希",
   "セリフ": "『ちなみに、晩ご飯はボクの大好きなカレーでしたー！\nねえねえ、東雲家は？』",
   "_kind": "talk"
  },
  {
   "話者": "",
   "セリフ": "bg_h000309",
   "_kind": "背景変化"
  },
  {
   "話者": "絵名",
   "セリフ": "『レンコンと豚肉の挟み焼き』",
   "_kind": "talk"
  },
  {
   "話者": "瑞希",
   "セリフ": "『え、何それ』",
   "_kind": "talk"
  },
  {
   "話者": "絵名",
   "セリフ": "『名前のまんま。\n豚肉をレンコンで挟んで焼いてあるヤツ』",
   "_kind": "talk"
  },
  {
   "話者": "",
   "セリフ": "bg_e000102",
   "_kind": "背景変化"
  },
  {
   "話者": "奏",
   "セリフ": "『そんな料理あるんだね……。\n望月さんなら知ってるかな……』",
   "_kind": "talk"
  },
  {
   "話者": "",
   "セリフ": "bg_h000109",
   "_kind": "背景変化"
  },
  {
   "話者": "瑞希",
   "セリフ": "『たしかに、知ってそう！\nで、宵崎家の晩ご飯はなんだったの？』",
   "_kind": "talk"
  },
  {
   "話者": "奏",
   "セリフ": "『え？　えっと……肉じゃがと\nもやしのナムルとかを食べたよ』",
   "_kind": "talk"
  },
  {
   "話者": "",
   "セリフ": "bg_h000108",
   "_kind": "背景変化"
  },
  {
   "話者": "絵名",
   "セリフ": "『へえ、穂波ちゃんの肉じゃがかあ。\n美味しそうだね』",
   "_kind": "talk"
  },
  {
   "話者": "奏",
   "セリフ": "『すごく美味しかったよ。\n食べやすいように、さっぱりした味にしてくれてるし』",
   "_kind": "talk"
  },
  {
   "話者": "",
   "セリフ": "bg_h000109",
   "_kind": "背景変化"
  },
  {
   "話者": "瑞希",
   "セリフ": "『うんうん。\nちゃんとご飯食べてるみたいでよかったよ』",
   "_kind": "talk"
  },
  {
   "話者": "",
   "セリフ": "bg_h000309",
   "_kind": "背景変化"
  },
  {
   "話者": "絵名",
   "セリフ": "『何それ。親みたいなこと言っちゃって』",
