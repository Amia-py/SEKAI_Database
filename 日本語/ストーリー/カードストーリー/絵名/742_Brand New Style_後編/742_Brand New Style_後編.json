  },
  {
   "話者": "",
   "セリフ": "bg_h000307",
   "_kind": "背景変化"
  },
  {
   "話者": "絵名",
   "セリフ": "『うん、いってらっしゃい』",
   "_kind": "talk"
  },
  {
   "話者": "",
   "セリフ": "se00098_b",
