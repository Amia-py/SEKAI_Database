  },
  {
   "話者": "",
   "セリフ": "bg_h000309",
   "_kind": "背景変化"
  },
  {
   "話者": "絵名",
   "セリフ": "『……あ、そういえば。\nAmia、今日学校行ったの？』",
   "_kind": "talk"
  },
  {
   "話者": "瑞希",
   "セリフ": "『あれ？　えななんまで親みたいなこと言いだした～』",
   "_kind": "talk"
  },
  {
   "話者": "絵名",
   "セリフ": "『はいはい。で、どうなの？』",
   "_kind": "talk"
  },
  {
   "話者": "瑞希",
   "セリフ": "『ちゃ～んと遅刻しないで行ったよ。\n始業式にまで出たの、偉くない？』",
   "_kind": "talk"
  },
  {
   "話者": "絵名",
   "セリフ": "『それが普通だけどね……』",
   "_kind": "talk"
  },
  {
   "話者": "瑞希",
   "セリフ": "『まあね！　でも、それがどうかした？』",
   "_kind": "talk"
  },
  {
   "話者": "",
   "セリフ": "bg_e000303",
   "_kind": "背景変化"
  },
  {
   "話者": "絵名",
   "セリフ": "『たいしたことじゃないんだけど、学校に行ったら\nまだ廊下にクラス替えの紙が貼ってあったの』",
   "_kind": "talk"
  },
  {
   "話者": "",
   "セリフ": "bg_h000309",
   "_kind": "背景変化"
  },
  {
   "話者": "瑞希",
   "セリフ": "『へえ、そうなんだ？　はがし忘れたのかな』",
   "_kind": "talk"
  },
  {
   "話者": "絵名",
   "セリフ": "『多分ね』",
   "_kind": "talk"
  },
  {
   "話者": "",
   "セリフ": "bg_e000303",
   "_kind": "背景変化"
  },
  {
   "話者": "絵名",
   "セリフ": "『ちょっと興味わいて見たんだけど、\n彰人は白石さんと、Amiaは冬弥くんと同じクラスみたいじゃん』",
   "_kind": "talk"
  },
  {
   "話者": "",
   "セリフ": "bg_h000309",
   "_kind": "背景変化"
  },
  {
   "話者": "瑞希",
   "セリフ": "『そうそう！　自分で言うのもおかしいけど、\nなんかおもしろい組み合わせだよね～』",
   "_kind": "talk"
  },
  {
   "話者": "絵名",
   "セリフ": "『彰人と白石さんはともかく、\nAmiaと冬弥くんってどういう話するの？』",
   "_kind": "talk"
  },
  {
   "話者": "瑞希",
   "セリフ": "『ん～、音楽の話もするし。\n本とかアニメとか、お互いのオススメ作品について\n教え合ったりとかいろいろだよ』",
   "_kind": "talk"
  },
  {
   "話者": "瑞希",
   "セリフ": "『冬弥くんって聞き上手だから、\nついいっぱい話しちゃうんだよね～』",
   "_kind": "talk"
  },
  {
   "話者": "絵名",
   "セリフ": "『へえ、よかったじゃん』",
   "_kind": "talk"
  },
  {
   "話者": "絵名",
   "セリフ": "『けど冬弥くん純粋なんだから、\n変なこと教えないでよ？』",
   "_kind": "talk"
  },
  {
   "話者": "瑞希",
   "セリフ": "『あはは！　しないよ、そんなこと。\n弟くんに怒られちゃうし、\n冬弥くんとは普通に仲良しでいたいしね』",
   "_kind": "talk"
  },
  {
   "話者": "",
   "セリフ": "bg_e000303",
   "_kind": "背景変化"
  },
  {
   "話者": "絵名",
