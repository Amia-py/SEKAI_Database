  {
   "話者": "絵名",
   "セリフ": "『……Amiaは、まだ起きてるの？』",
   "_kind": "talk"
  },
  {
   "話者": "瑞希",
   "セリフ": "『んー、もう少し起きてようかな～。\nえななんがさみしがっちゃうし？』",
   "_kind": "talk"
  },
  {
   "話者": "絵名",
   "セリフ": "『何それ』",
   "_kind": "talk"
  },
  {
   "話者": "絵名",
   "セリフ": "『…………あのさ』",
   "_kind": "talk"
  },
  {
   "話者": "瑞希",
   "セリフ": "『ん、どうかした？』",
   "_kind": "talk"
  },
  {
   "話者": "絵名",
   "セリフ": "『……展示会とかイベントとか、\nそんなに頑張って誘わなくてもよくない？』",
   "_kind": "talk"
  },
  {
   "話者": "絵名",
   "セリフ": "『人形展の時みたいになられたら迷惑だし』",
   "_kind": "talk"
  },
  {
   "話者": "瑞希",
   "セリフ": "『へえ～……』",
   "_kind": "talk"
  },
  {
   "話者": "絵名",
   "セリフ": "『な、何？』",
   "_kind": "talk"
  },
  {
   "話者": "瑞希",
   "セリフ": "『んーん、雪が心配なんだな～って思ってさ』",
   "_kind": "talk"
  },
  {
   "話者": "絵名",
   "セリフ": "『は？　勝手に決めつけないでよ。\nそんなんじゃないから』",
   "_kind": "talk"
  },
  {
   "話者": "絵名",
   "セリフ": "『ただ……雪のあんな姿見て、びっくりしたのかも』",
   "_kind": "talk"
  },
  {
   "話者": "瑞希",
   "セリフ": "『……そうだね、ボクも驚いた』",
   "_kind": "talk"
  },
  {
   "話者": "絵名",
   "セリフ": "『でしょ？　もし、どこか出かけて、\nまたあんな感じになったら――』",
   "_kind": "talk"
  },
  {
   "話者": "絵名",
   "セリフ": "『…………』",
   "_kind": "talk"
  },
  {
   "話者": "瑞希",
   "セリフ": "『でもさ、あれってショック療法みたいなものだから\nそこまで気にしなくてもいいんじゃないかな』",
   "_kind": "talk"
  },
  {
   "話者": "絵名",
   "セリフ": "『ショック療法って……』",
   "_kind": "talk"
  },
  {
   "話者": "絵名",
   "セリフ": "『もし、そのショックが大きすぎたらどうするの？\n雪がまた消えたいって強く思ったら……』",
   "_kind": "talk"
  },
  {
   "話者": "絵名",
   "セリフ": "『雪を助けたいって思ってるKだって、\n傷つけちゃうんじゃないの？』",
   "_kind": "talk"
  },
  {
   "話者": "瑞希",
   "セリフ": "『うん……。\nボク達にも、覚悟がいるのかもしれないね』",
   "_kind": "talk"
  },
  {
   "話者": "絵名",
   "セリフ": "『覚悟……？』",
   "_kind": "talk"
  },
  {
   "話者": "瑞希",
   "セリフ": "『そ。前に、Kが雪に見せたみたいにさ』",
   "_kind": "talk"
  },
  {
   "話者": "瑞希",
   "セリフ": "『絶対助ける。見捨てないっていう、そういう覚悟』",
   "_kind": "talk"
  },
  {
   "話者": "絵名",
   "セリフ": "『…………』",
   "_kind": "talk"
  },
  {
   "話者": "瑞希",
   "セリフ": "『人の一生に首を突っ込むって、\nきっとそういうことなんじゃないかな』",
   "_kind": "talk"
  },
  {
   "話者": "絵名",
   "セリフ": "『……そんなこと言われても、私は……』",
   "_kind": "talk"
  },
  {
   "話者": "瑞希",
   "セリフ": "『まあ、みんな、向き合い方を探してる途中だと思うんだよね。\nKは雪への、それに……雪は自分への』",
   "_kind": "talk"
  },
  {
   "話者": "瑞希",
   "セリフ": "『だから、えななんも難しく考えなくていいと思うな。\nボクだって正直なところ、よくわかってないしさ』",
   "_kind": "talk"
  },
  {
   "話者": "絵名",
   "セリフ": "『……気楽でいいね、Amiaは』",
   "_kind": "talk"
  },
  {
