  },
  {
   "話者": "絵名",
   "セリフ": "『みんな、お疲れー。\nごめん、ちょっと遅くなっちゃった』",
   "_kind": "talk"
  },
  {
   "話者": "",
   "セリフ": "bg_e000102",
   "_kind": "背景変化"
  },
  {
   "話者": "奏",
   "セリフ": "『あ、えななん。\n大丈夫だよ。わたし達も今集まったところだから』",
