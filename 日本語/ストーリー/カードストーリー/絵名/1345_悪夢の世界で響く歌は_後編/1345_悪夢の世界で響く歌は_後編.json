  },
  {
   "話者": "",
   "セリフ": "bg_e000303",
   "_kind": "背景変化"
  },
  {
   "話者": "絵名",
   "セリフ": "『いやもうホント驚いたから……！\n歌おうと思って出てったら、目の前にいるんだもん』",
