  },
  {
   "話者": "",
   "セリフ": "bg_e000303",
   "_kind": "背景変化"
  },
  {
   "話者": "絵名",
   "セリフ": "『たくさんお客さんが来てくれたって聞いてるし、\nいい個展になったんじゃないかな』",
