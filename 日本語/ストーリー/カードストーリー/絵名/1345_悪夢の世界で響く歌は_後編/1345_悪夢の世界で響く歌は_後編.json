  },
  {
   "話者": "",
   "セリフ": "bg_h000309",
   "_kind": "背景変化"
  },
  {
   "話者": "絵名",
   "セリフ": "『全っ然。むしろ戸惑ってるのが、\n顔に出てないかひやひやしたんだけど』",
   "_kind": "talk"
  },
  {
   "話者": "絵名",
   "セリフ": "『っていうか、来るならひとこと言ってくれればいいのに。\nなんで急に来るわけ？』",
