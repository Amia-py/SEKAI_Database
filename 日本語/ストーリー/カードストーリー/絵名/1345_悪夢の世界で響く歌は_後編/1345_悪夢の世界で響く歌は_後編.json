  },
  {
   "話者": "",
   "セリフ": "bg_e000403",
   "_kind": "背景変化"
  },
  {
   "話者": "瑞希",
   "セリフ": "『ていうか、個展の最終日は忙しかったんじゃない？\n今日くらい休んでもよかったのに〜』",
   "_kind": "talk"
  },
  {
   "話者": "",
   "セリフ": "bg_h000407",
   "_kind": "背景変化"
  },
  {
   "話者": "まふゆ",
   "セリフ": "『個展、今日までだったんだ』",
