  },
  {
   "話者": "",
   "セリフ": "bg_e000102",
   "_kind": "背景変化"
  },
  {
   "話者": "奏",
   "セリフ": "『ふふっ』",
   "_kind": "talk"
  },
  {
   "話者": "奏",
   "セリフ": "『でも、えななんのお母さんは、\nすごく優しそうな人だね』",
   "_kind": "talk"
  },
  {
   "話者": "奏",
   "セリフ": "『急に誰かが泊まることになっても、\n許してくれるなんて』",
   "_kind": "talk"
  },
  {
   "話者": "",
   "セリフ": "bg_h000407",
   "_kind": "背景変化"
  },
  {
   "話者": "瑞希",
   "セリフ": "『たしかに！\nこれでいつでも宿には困らないね～』",
   "_kind": "talk"
  },
  {
   "話者": "",
   "セリフ": "bg_h000409",
   "_kind": "背景変化"
  },
  {
   "話者": "絵名",
   "セリフ": "『ちょっと。Amiaまでうちに泊まりたいとか\n言いださないでよ？』",
   "_kind": "talk"
  },
  {
   "話者": "絵名",
   "セリフ": "『今回は、雪が心配で泊めただけなんだから』",
   "_kind": "talk"
  },
  {
   "話者": "瑞希",
   "セリフ": "『わかってるって。\nそんなこと言い出さないから、安心していいよ』",
