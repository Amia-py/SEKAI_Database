  },
  {
   "話者": "瑞希",
   "セリフ": "『うんうん、よろしく！』",
   "_kind": "talk"
  },
  {
   "話者": "",
   "セリフ": "bg_e000403",
   "_kind": "背景変化"
  },
  {
   "話者": "瑞希",
   "セリフ": "（えーっと、時間はっと……。25時、10分前か。\nじゃあもうちょっとしゃべってても平気かな）",
   "_kind": "talk"
  },
  {
   "話者": "瑞希",
   "セリフ": "『——ところでさ、えななん。\n急に雪を家に連れていって、えななんのお母さんは\n驚かなかった？』",
   "_kind": "talk"
  },
  {
   "話者": "",
   "セリフ": "bg_h000409",
   "_kind": "背景変化"
  },
  {
   "話者": "絵名",
   "セリフ": "『え？　あー、そんなに、かな。\n愛莉を連れていった時のほうが驚いてたかも』",
   "_kind": "talk"
  },
  {
   "話者": "",
   "セリフ": "bg_h000108",
   "_kind": "背景変化"
  },
  {
   "話者": "奏",
   "セリフ": "『……えっと、花里さんとアイドルやってる人、だっけ？』",
