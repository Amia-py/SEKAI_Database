  },
  {
   "話者": "",
   "セリフ": "bg_h000409",
   "_kind": "背景変化"
  },
  {
   "話者": "絵名",
   "セリフ": "『本当にそういう感じだったけど……。\nなんかその言いかたはムカつく』",
