  },
  {
   "話者": "絵名",
   "セリフ": "『そうそう！　その愛莉！』",
   "_kind": "talk"
  },
  {
   "話者": "",
   "セリフ": "bg_h000409",
   "_kind": "背景変化"
  },
  {
   "話者": "瑞希",
   "セリフ": "『いやいやいや、お茶の間のアイドルの愛莉ちゃんが\n家に来るなんて、誰でも驚くでしょ！』",
   "_kind": "talk"
  },
  {
   "話者": "絵名",
   "セリフ": "『ああ、それもあるんだけど……』",
   "_kind": "talk"
  },
  {
   "話者": "絵名",
   "セリフ": "『……たしか、愛莉の受け答えが\n中学生とは思えないくらい丁寧だったから、かな』",
   "_kind": "talk"
  },
  {
   "話者": "瑞希",
   "セリフ": "『あ～。なるほど』",
