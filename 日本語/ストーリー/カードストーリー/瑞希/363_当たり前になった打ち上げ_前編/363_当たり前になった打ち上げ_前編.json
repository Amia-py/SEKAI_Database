  },
  {
   "話者": "",
   "セリフ": "bg_h000409",
   "_kind": "背景変化"
  },
  {
   "話者": "瑞希",
   "セリフ": "『あれ？　そうだったっけ？』",
   "_kind": "talk"
  },
  {
   "話者": "絵名",
   "セリフ": "『覚えてないの？』",
   "_kind": "talk"
  },
  {
   "話者": "",
   "セリフ": "se00053",
