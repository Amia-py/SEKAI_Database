  },
  {
   "話者": "まふゆ",
   "セリフ": "『え……。私が作った、あの最初のアレンジ曲？』",
   "_kind": "talk"
  },
  {
   "話者": "",
   "セリフ": "bg_h000207",
   "_kind": "背景変化"
  },
  {
   "話者": "奏",
   "セリフ": "『うん。あれを聴いていたら、\n新しい曲のイメージがどんどんわいてきて』",
   "_kind": "talk"
  },
  {
   "話者": "奏",
   "セリフ": "『いても立ってもいられなくて、\nその日のうちに１曲作ったんだ』",
   "_kind": "talk"
  },
  {
   "話者": "まふゆ",
   "セリフ": "『そうだったんだ……』",
   "_kind": "talk"
  },
  {
   "話者": "",
   "セリフ": "bg_e000403",
   "_kind": "背景変化"
  },
  {
   "話者": "瑞希",
   "セリフ": "『へえ……』",
   "_kind": "talk"
  },
  {
   "話者": "瑞希",
   "セリフ": "（それがふたりの出会いだったんだ……）",
   "_kind": "talk"
  },
  {
   "話者": "瑞希",
   "セリフ": "（最初から、心のどこかでなんとなく、\n“ああ、みんな同類だ”って思ってたけど……）",
   "_kind": "talk"
  },
  {
   "話者": "瑞希",
   "セリフ": "（あの頃からずっと、\n奏もまふゆも相当つらかったんだろうな）",
   "_kind": "talk"
  },
  {
   "話者": "",
   "セリフ": "bg_e000102",
   "_kind": "背景変化"
  },
  {
   "話者": "奏",
   "セリフ": "『あ、そういえば……。その曲をアップする前に\n意識なくして倒れちゃったんだよね』",
   "_kind": "talk"
  },
  {
   "話者": "",
   "セリフ": "bg_e000403",
   "_kind": "背景変化"
  },
  {
   "話者": "瑞希",
   "セリフ": "（……やっぱり。聞いてる感じ、\n健康にも相当悪い生活を送って……んっ！？）",
   "_kind": "talk"
  },
  {
   "話者": "",
   "セリフ": "bg_h000407",
   "_kind": "背景変化"
  },
  {
   "話者": "奏",
   "セリフ": "『その日、たまたまおばあちゃんに頼まれた、\n家事代行センターの人達が家に来てて、\n倒れてたわたしを見つけてくれて——』",
   "_kind": "talk"
  },
  {
   "話者": "瑞希",
   "セリフ": "『ちょっ！　ストップストーップ！！』",
   "_kind": "talk"
  },
  {
   "話者": "奏",
   "セリフ": "『ん？　何か気になるところあった？』",
   "_kind": "talk"
  },
  {
   "話者": "瑞希",
   "セリフ": "『むしろ気になるところしかないよ！？』",
   "_kind": "talk"
  },
  {
   "話者": "",
   "セリフ": "bg_h000307",
   "_kind": "背景変化"
  },
  {
   "話者": "絵名",
   "セリフ": "『そうだよ、K！\nだって今、意識を失って倒れたって……』",
   "_kind": "talk"
  },
  {
   "話者": "奏",
   "セリフ": "『ああ、うん。\n気づいたら病院だった』",
   "_kind": "talk"
  },
  {
   "話者": "",
   "セリフ": "bg_h000409",
   "_kind": "背景変化"
  },
  {
   "話者": "瑞希",
   "セリフ": "『うん、じゃないよ……』",
   "_kind": "talk"
  },
  {
   "話者": "瑞希",
   "セリフ": "『K、カップ麺ばかり食べてるって言ってたから、\nいつか倒れるんじゃあって思ってたけど……。\nまさか、前科があったなんて』",
   "_kind": "talk"
  },
  {
   "話者": "",
   "セリフ": "bg_h000207",
   "_kind": "背景変化"
  },
  {
   "話者": "まふゆ",
   "セリフ": "『ほとんど断食みたいな生活してたんだね』",
   "_kind": "talk"
  },
  {
   "話者": "奏",
   "セリフ": "『今はちゃんと気をつけてるよ。\nカップ麺ばかりじゃ偏るから、栄養ドリンク飲んだり、\n完全栄養食品とか食べるようにしてるし』",
   "_kind": "talk"
  },
  {
   "話者": "奏",
   "セリフ": "『それにお手伝いさんが掃除もして、\n美味しいご飯も作ってくれるから、すごく助かってる』",
   "_kind": "talk"
  },
  {
   "話者": "",
   "セリフ": "bg_h000407",
   "_kind": "背景変化"
  },
  {
   "話者": "瑞希",
   "セリフ": "『お手伝いさんとも、その頃にはもう会ってたんだね』",
   "_kind": "talk"
  },
  {
   "話者": "奏",
   "セリフ": "『うん、ちょうど職場体験に来てたみたい。\nそれで、倒れてるわたしを見つけてくれて……』",
   "_kind": "talk"
  },
  {
   "話者": "瑞希",
   "セリフ": "『あ、その人がKのこと助けてくれたんだ！？』",
   "_kind": "talk"
  },
  {
   "話者": "奏",
   "セリフ": "『そう。それでおばあちゃんが、\nこれも何かの縁だからって』",
   "_kind": "talk"
  },
  {
   "話者": "",
   "セリフ": "bg_h000208",
   "_kind": "背景変化"
  },
  {
   "話者": "絵名",
   "セリフ": "『そういえばその子、\n雪と同じ学校の子じゃなかったっけ？』",
   "_kind": "talk"
  },
  {
   "話者": "まふゆ",
   "セリフ": "『そうだよ』",
