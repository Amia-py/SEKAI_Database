   "セリフ": "bg_h000407",
   "_kind": "背景変化"
  },
  {
   "話者": "瑞希",
   "セリフ": "『正解♪　もう、コンセプト聞いてから\nすごい勢いでアイディアがわいてきてさあ！\n早くデザインにおこしたかったんだよね』",
   "_kind": "talk"
  },
  {
   "話者": "奏",
   "セリフ": "『そっか。Amiaがデザインするなら、\nすごくいいおばけになりそうだね』",
   "_kind": "talk"
  },
  {
   "話者": "",
   "セリフ": "bg_e000303",
   "_kind": "背景変化"
  },
  {
   "話者": "絵名",
   "セリフ": "『……肝試し？　衣装？\n待って、話についていけてないの私だけ？』",
   "_kind": "talk"
  },
  {
   "話者": "",
   "セリフ": "bg_h000409",
   "_kind": "背景変化"
  },
  {
   "話者": "瑞希",
   "セリフ": "『あ、そっか。えななんは知らないんだっけ』",
   "_kind": "talk"
  },
  {
   "話者": "",
   "セリフ": "bg_e000403",
   "_kind": "背景変化"
  },
  {
   "話者": "瑞希",
   "セリフ": "『雪とえむちゃんが、学級委員の活動で\n草むしりのボランティアをやることになったらしいんだ』",
   "_kind": "talk"
  },
  {
   "話者": "瑞希",
   "セリフ": "『それでいろいろあって、\n神社で肝試しをやることになったんだって！』",
   "_kind": "talk"
  },
  {
   "話者": "",
   "セリフ": "bg_h000409",
   "_kind": "背景変化"
  },
  {
   "話者": "絵名",
   "セリフ": "『ちょっと、さすがにそれは端折りすぎでしょ！\n何をどうやったら、草むしりが肝試しになるわけ？』",
   "_kind": "talk"
  },
  {
   "話者": "瑞希",
   "セリフ": "『え～？\nボクたちの仲だったら、今ので通じると思ったのにな～？』",
   "_kind": "talk"
  },
  {
   "話者": "",
   "セリフ": "bg_e000102",
   "_kind": "背景変化"
  },
  {
   "話者": "奏",
   "セリフ": "『えっと……肝試しは、鳳さんの案なんだよね』",
   "_kind": "talk"
  },
  {
   "話者": "まふゆ",
   "セリフ": "『……うん。草むしりのボランティアだけじゃ、\nなかなか人が集まらないから』",
   "_kind": "talk"
  },
  {
   "話者": "まふゆ",
   "セリフ": "『楽しいイベントを一緒にすればいいんじゃないかって\n鳳さんの提案で、草むしりをする神社の敷地を借りて、\n肝試しをしようってことになった』",
   "_kind": "talk"
  },
  {
   "話者": "",
   "セリフ": "bg_e000303",
   "_kind": "背景変化"
  },
  {
   "話者": "絵名",
   "セリフ": "『ふーん、楽しいことかあ……。\nなんだかえむちゃんらしいね』",
   "_kind": "talk"
  },
  {
   "話者": "",
   "セリフ": "bg_h000409",
   "_kind": "背景変化"
  },
  {
   "話者": "瑞希",
   "セリフ": "『ちなみに、“怖がりの人でも楽しめる！”っていうのが\nコンセプトらしいよ』",
   "_kind": "talk"
  },
  {
   "話者": "",
   "セリフ": "bg_e000403",
   "_kind": "背景変化"
  },
  {
   "話者": "瑞希",
   "セリフ": "『そうだ。\nよかったら、えななんも参加しない？』",
   "_kind": "talk"
  },
  {
   "話者": "",
   "セリフ": "bg_h000409",
   "_kind": "背景変化"
  },
  {
   "話者": "絵名",
   "セリフ": "『え、私？』",
   "_kind": "talk"
  },
  {
   "話者": "瑞希",
   "セリフ": "『実はそのボランティア、穂波ちゃんと雫ちゃんも\n参加するんだよね！　結構知り合いもいるし、\nえななんも楽しめるんじゃないかな〜って！』",
   "_kind": "talk"
  },
  {
   "話者": "絵名",
   "セリフ": "『へえ、たしかにおもしろそうかも』",
   "_kind": "talk"
  },
  {
   "話者": "",
   "セリフ": "bg_e000303",
   "_kind": "背景変化"
  },
  {
   "話者": "絵名",
   "セリフ": "『いやでも、草むしりかあ……。\n虫とかいそうだし、手も汚れそうだしな……』",
