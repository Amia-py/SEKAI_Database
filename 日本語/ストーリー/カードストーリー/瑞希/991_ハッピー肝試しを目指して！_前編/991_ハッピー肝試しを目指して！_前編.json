  },
  {
   "話者": "",
   "セリフ": "bg_h000409",
   "_kind": "背景変化"
  },
  {
   "話者": "瑞希",
   "セリフ": "『あーあ、そんなこと言って〜』",
   "_kind": "talk"
  },
  {
   "話者": "瑞希",
   "セリフ": "『えむちゃんが泣いちゃうぞー？\nせっかく楽しいイベントにしようって、\nすっごくがんばってるんだからさ！』",
   "_kind": "talk"
  },
  {
   "話者": "絵名",
   "セリフ": "『わかってるけど……\nそれはそれ、これはこれでしょ』",
   "_kind": "talk"
  },
  {
   "話者": "",
   "セリフ": "bg_e000303",
   "_kind": "背景変化"
  },
  {
   "話者": "絵名",
   "セリフ": "『まあでも、怖くないっていうなら、\n肝試しから参加とかならありかも』",
