  },
  {
   "話者": "",
   "セリフ": "bg_a000801",
   "_kind": "背景変化"
  },
  {
   "話者": "遥",
   "セリフ": "……みのり、あの時はごめんね。\nせっかく前向きに考えようとしてくれてたのに",
   "_kind": "talk"
  },
  {
   "話者": "みのり",
   "セリフ": "え？　あ、ううん！\nわたしのほうこそファンのみんなのこと\nちゃんと考えられてなかったし、気にしないで！",
   "_kind": "talk"
  },
  {
   "話者": "みのり",
   "セリフ": "えっと、それでね……",
   "_kind": "talk"
  },
  {
   "話者": "みのり",
   "セリフ": "次にイベントをやる時には、そういうことも意識して\n意見とか、企画の提案をしたいって思ってるんだ",
   "_kind": "talk"
  },
  {
   "話者": "みのり",
   "セリフ": "だから、そういうのの気をつけかたとかあったら、\nいろいろ教えてほしいなって！",
   "_kind": "talk"
  },
  {
   "話者": "遥",
   "セリフ": "みのり……",
   "_kind": "talk"
  },
  {
   "話者": "遥",
   "セリフ": "わかった。じゃあ、私も真剣に答えるね",
