   "セリフ": "se00251_b",
   "_kind": "効果音・BGM"
  },
  {
   "話者": "MEIKO",
   "セリフ": "会場のみんなまで？\nしょうがないわねえ",
   "_kind": "talk"
  },
  {
   "話者": "MEIKO",
