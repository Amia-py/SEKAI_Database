  },
  {
   "話者": "",
   "セリフ": "se00211_b",
   "_kind": "効果音・BGM"
  },
  {
   "話者": "KAITO",
   "セリフ": "せっかくだし、どんなことを意識しながら\n歌ったのか教えてほしいな",
