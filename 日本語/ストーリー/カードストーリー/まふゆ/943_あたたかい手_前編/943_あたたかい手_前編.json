  },
  {
   "話者": "まふゆ",
   "セリフ": "…………",
   "_kind": "talk"
  },
  {
   "話者": "奏",
   "セリフ": "……一緒にやってみない？",
   "_kind": "talk"
  },
  {
   "話者": "まふゆ",
   "セリフ": "……準備もしてもらったみたいだし、やろうかな",
   "_kind": "talk"
  },
  {
   "話者": "穂波",
   "セリフ": "それじゃあ、すぐに餡の準備しますね",
   "_kind": "talk"
  },
  {
   "話者": "",
   "セリフ": "bgm00000",
   "_kind": "効果音・BGM"
  },
  {
   "話者": "穂波",
   "セリフ": "おまたせしました。\n皮で餡を包んでいきましょうか",
   "_kind": "talk"
  },
  {
   "話者": "",
   "セリフ": "bgm00171",
   "_kind": "効果音・BGM"
  },
  {
   "話者": "奏",
   "セリフ": "うん。\nあ、そういえばまふゆはやったことある？",
   "_kind": "talk"
  },
  {
   "話者": "まふゆ",
   "セリフ": "……あるよ。\nお母さんの手伝いとか、家庭科の調理実習で",
   "_kind": "talk"
  },
  {
   "話者": "奏",
   "セリフ": "そっか。わたしも小さい頃に\n手伝いでやったことあるけど、できるかな……",
   "_kind": "talk"
  },
  {
   "話者": "奏",
   "セリフ": "最初、ふたりが作るのを見ててもいい？",
   "_kind": "talk"
  },
  {
   "話者": "穂波",
   "セリフ": "わかりました",
   "_kind": "talk"
  },
  {
   "話者": "穂波",
   "セリフ": "朝比奈先輩、これが普通の餃子の皮で、\nこっちは水餃子用になります",
   "_kind": "talk"
  },
  {
   "話者": "まふゆ",
   "セリフ": "……じゃあ、まず普通のからやろうかな",
   "_kind": "talk"
  },
  {
   "話者": "奏",
   "セリフ": "……まふゆ、ひだ作るのうまいね",
   "_kind": "talk"
  },
  {
   "話者": "まふゆ",
   "セリフ": "……そうかな。普通だと思うけど……",
   "_kind": "talk"
  },
  {
   "話者": "まふゆ",
   "セリフ": "……包んだのは、どこに置けばいい？",
   "_kind": "talk"
  },
  {
   "話者": "穂波",
   "セリフ": "小皿に片栗粉を出してあるので、\nそれを餃子の底に少しつけて、お皿の上に置いてください",
   "_kind": "talk"
  },
  {
   "話者": "まふゆ",
   "セリフ": "（……皮は水餃子の分も合わせて、30枚ちょっとかな）",
   "_kind": "talk"
  },
  {
   "話者": "まふゆ",
   "セリフ": "（望月さんが餡を３等分にしてくれてるから……。\nとりあえず10個くらい作ればよさそう）",
   "_kind": "talk"
  },
  {
   "話者": "奏",
   "セリフ": "……わたしもやってみようかな。\nえっと、まず皮に餡を乗せて……",
