  },
  {
   "話者": "",
   "セリフ": "bg_h000108",
   "_kind": "背景変化"
  },
  {
   "話者": "絵名",
   "セリフ": "『穂波ちゃんに？』",
   "_kind": "talk"
  },
  {
   "話者": "まふゆ",
   "セリフ": "『うん。昼休みにお祝いしたいけど、\n時間はあるかって聞かれて……』",
   "_kind": "talk"
  },
  {
   "話者": "絵名",
   "セリフ": "『へえ、学校でもパーティーあるんだ。\nどんなことするんだろ？』",
