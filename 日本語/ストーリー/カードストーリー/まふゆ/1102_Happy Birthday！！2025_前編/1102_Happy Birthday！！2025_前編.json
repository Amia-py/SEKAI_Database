  },
  {
   "話者": "",
   "セリフ": "bg_e000403",
   "_kind": "背景変化"
  },
  {
   "話者": "瑞希",
   "セリフ": "『——って、そんなこと話してる間に、もうすぐ０時じゃん！\nみんな、お祝いの準備はいい？』",
