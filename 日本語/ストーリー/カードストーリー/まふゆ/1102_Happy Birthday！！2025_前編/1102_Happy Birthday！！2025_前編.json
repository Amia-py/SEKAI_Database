  {
   "話者": "",
   "セリフ": "bg_h000309",
   "_kind": "背景変化"
  },
  {
   "話者": "瑞希",
   "セリフ": "『オフラインで作業してたら、結構ノッちゃってさあ。\n気づいたらこんな時間になってたんだよねー』",
   "_kind": "talk"
  },
  {
   "話者": "",
   "セリフ": "bg_h000109",
   "_kind": "背景変化"
  },
  {
   "話者": "まふゆ",
   "セリフ": "『……まだ、25時までは時間あるけど』",
   "_kind": "talk"
  },
  {
   "話者": "瑞希",
   "セリフ": "『いやいや、そういうことじゃなくて……。\nほら、もうすぐ日付変わるじゃん！\n雪をお祝いしなきゃでしょ？』",
   "_kind": "talk"
  },
  {
   "話者": "",
   "セリフ": "bg_e000102",
   "_kind": "背景変化"
  },
  {
   "話者": "",
   "セリフ": "bg_e000303",
   "_kind": "背景変化"
  },
  {
   "話者": "絵名",
   "セリフ": "『ほんと……誕生日になったらすぐお祝いするんだーって\n張り切ってたのに、全然来ないからどうしたのかと思った』",
   "_kind": "talk"
  },
  {
   "話者": "",
   "セリフ": "bg_h000309",
   "_kind": "背景変化"
  },
  {
   "話者": "瑞希",
   "セリフ": "『ごめんごめん。\nまあでも、間に合ったんだしオッケーってことで！』",
   "_kind": "talk"
  },
  {
   "話者": "",
   "セリフ": "bg_e000403",
   "_kind": "背景変化"
  },
  {
   "話者": "瑞希",
   "セリフ": "『明日はセカイでパーティーもあるし、楽しみだなあ。\n雪は予定、大丈夫そう？』",
   "_kind": "talk"
  },
  {
   "話者": "",
   "セリフ": "bg_h000109",
   "_kind": "背景変化"
  },
  {
   "話者": "まふゆ",
   "セリフ": "『……部活があるけど、夜までには帰れると思う』",
   "_kind": "talk"
  },
  {
   "話者": "瑞希",
   "セリフ": "『そっか。じゃあボク達も、\nそれまでに準備終わらせておかなくちゃね！』",
   "_kind": "talk"
  },
  {
   "話者": "",
   "セリフ": "bg_e000102",
   "_kind": "背景変化"
  },
  {
   "話者": "奏",
   "セリフ": "『あ、パーティーっていえば……。\n雪、望月さんにも誘われてなかった？』",
