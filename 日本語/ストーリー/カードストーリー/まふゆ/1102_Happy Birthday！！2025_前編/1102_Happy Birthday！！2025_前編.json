  },
  {
   "話者": "",
   "セリフ": "bg_h000109",
   "_kind": "背景変化"
  },
  {
   "話者": "瑞希",
   "セリフ": "『ふふ。きっと雪のために、\nいろいろ準備してくれてるんじゃないかなあ』",
