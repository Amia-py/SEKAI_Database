  },
  {
   "話者": "",
   "セリフ": "bg_h000209",
   "_kind": "背景変化"
  },
  {
   "話者": "瑞希",
   "セリフ": "『そういえば、前にアップした曲、\n最後の最後でちょっと歌詞に手を入れてたね』",
   "_kind": "talk"
  },
  {
   "話者": "まふゆ",
   "セリフ": "『うん。イラストを見て、\nもっといい表現を思いついたから変えたの』",
   "_kind": "talk"
  },
  {
   "話者": "まふゆ",
   "セリフ": "『えななんには、\n“あそこ良かったのになんで変えたの”って言われたけど』",
