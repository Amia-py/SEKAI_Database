  },
  {
   "話者": "",
   "セリフ": "bg_h000407",
   "_kind": "背景変化"
  },
  {
   "話者": "瑞希",
   "セリフ": "『そうそう、えななんしばらくご乱心で\nちょっとおもしろかった』",
