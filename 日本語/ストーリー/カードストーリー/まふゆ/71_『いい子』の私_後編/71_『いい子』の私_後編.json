  },
  {
   "話者": "まふゆ",
   "セリフ": "『もし、このまま変化し続けていったら……』",
   "_kind": "talk"
  },
  {
   "話者": "まふゆ",
   "セリフ": "『みんなの前だけじゃなく、学校や家でも、\n『いい子』じゃない自分が出てくるようになるのかな？』",
   "_kind": "talk"
  },
  {
   "話者": "まふゆ",
   "セリフ": "『……だけどそれは、成長といっていいの？\n順応？　もしかしたら、退化？』",
   "_kind": "talk"
  },
  {
   "話者": "まふゆ",
   "セリフ": "『私にはわからない。判断がつかない……』",
   "_kind": "talk"
  },
  {
   "話者": "まふゆ",
   "セリフ": "『それを……私自身が、どう思っているのか、\nどう感じているのかすらわからないの』",
   "_kind": "talk"
  },
  {
   "話者": "まふゆ",
   "セリフ": "『自分のことなのに……\n全然、わからない』",
   "_kind": "talk"
  },
  {
   "話者": "まふゆ",
   "セリフ": "『これって結局、私自身が、\nまだ私を見つけられていないから、こう思うのかな』",
   "_kind": "talk"
  },
  {
   "話者": "",
   "セリフ": "bg_h000201",
   "_kind": "背景変化"
  },
  {
   "話者": "奏",
   "セリフ": "『……雪、今日は、たくさんしゃべるね』",
